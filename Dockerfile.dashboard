# syntax=docker/dockerfile:1
# Build the static dashboard on the builder platform (host arch). Dist is arch-independent,
# which avoids lightningcss native optional-deps failures under QEMU arm64/musl cross-builds.
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

COPY dashboard/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY dashboard/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080
